# Integration test environment variables
# Copy to .env.integration and fill in real values

# Network selection: "mainnet" (default) or "testnet"
INTEGRATION_TEST_NETWORK=mainnet

# Neo N3 RPC endpoint (defaults to http://seed1.neo.org:10332)
INTEGRATION_N3_RPC=http://seed1.neo.org:10332

# Neo X RPC endpoint (defaults to https://mainnet-1.rpc.banelabs.org)
INTEGRATION_NEOX_RPC=https://mainnet-1.rpc.banelabs.org

# Discord webhook URL for alerter integration tests (optional — tests skip if not set)
INTEGRATION_DISCORD_WEBHOOK_URL=
