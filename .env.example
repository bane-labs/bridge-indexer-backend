# Bridge Indexer Backend - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ============================================================
# Required
# ============================================================

# Neo N3 JSON-RPC endpoints (comma-separated, supports multiple for failover)
NEO_N3_RPC_ENDPOINTS=http://seed1.neo.org:10332,http://seed2.neo.org:10332

# Neo X (EVM) JSON-RPC endpoints (comma-separated, supports multiple for failover)
NEOX_RPC_ENDPOINTS=https://mainnet-1.rpc.banelabs.org

# ============================================================
# Optional - Server
# ============================================================

# HTTP server port (default: 8080)
# SERVER_PORT=8080

# Comma-separated frontend origins allowed to call this API from browsers.
# Include scheme and optional port; do not include path.
# When empty (default), CORS is disabled — no browser cross-origin requests allowed.
# Example: CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ALLOWED_ORIGINS=

# Allow browser credentialed requests (cookies/HTTP auth/TLS client certs).
# When true, CORS_ALLOWED_ORIGINS cannot include '*'. Default: false.
# CORS_ALLOW_CREDENTIALS=false

# BadgerDB data directory (default: ./data/badger)
# DB_PATH=./data/badger
#
# N3 RPC call interval in milliseconds (default: 250).
# Increase this if your RPC endpoint starts timing out.
# N3_RPC_CALL_INTERVAL_MS=250
#
# NeoX RPC call interval in milliseconds (default: 100)
# NEOX_RPC_CALL_INTERVAL_MS=100
#
# N3 sync concurrency (default: 50). With multiple healthy RPC nodes (e.g. 5-7),
# you can often raise this (e.g. 80-140) for faster catch-up.
# If timeouts/429s appear, lower it again.
# N3_SYNC_CONCURRENCY=50
#
# Optional: contract deploy block for N3. Indexing starts from max(N3_START_BLOCK, N3_DEPLOY_BLOCK).
# Use this to skip chain history before bridge contracts existed.
# N3_DEPLOY_BLOCK=0
#
# NeoX sync concurrency (default: 20).
# NEOX_SYNC_CONCURRENCY=20
#
# Optional: contract deploy block for NeoX. Indexing starts from max(NEOX_START_BLOCK, NEOX_DEPLOY_BLOCK).
# NEOX_DEPLOY_BLOCK=0
#
# Automatically run backfill once both chains are synced (default: false).
# When enabled, this can trigger large historical scans for stuck operations.
# AUTO_BACKFILL_ENABLED=false

# ============================================================
# Optional - Monitoring
# ============================================================

# Stuck operation detection threshold in minutes (default: 5)
# STUCK_THRESHOLD_MINUTES=5
#
# Separate threshold for message bridge (NeoX MessageSend → N3) pending ops (default: 1440 = 24h).
# Executable messages can wait for relay/execution much longer than token/native transfers.
# Set to 0 to use STUCK_THRESHOLD_MINUTES for messages too.
# STUCK_THRESHOLD_MESSAGE_MINUTES=1440
#
# Optional overrides for native and token bridge pending ops (both directions). Default: 0 = use STUCK_THRESHOLD_MINUTES.
# STUCK_THRESHOLD_NATIVE_MINUTES=
# STUCK_THRESHOLD_TOKEN_MINUTES=

# ============================================================
# Optional - Alerting (Discord)
# ============================================================

# Discord webhook URL - leave empty to disable Discord alerts
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ============================================================
# Optional - Alerting (Email/SMTP)
# All SMTP fields + ALERT_RECIPIENTS must be set to enable email alerts
# ============================================================

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASS=your-password
# SMTP_FROM=alerts@example.com
# ALERT_RECIPIENTS=admin@example.com,ops@example.com

# ============================================================
# Optional - RPC Block Cache
# ============================================================

# Directory for the RPC block cache (BadgerDB). When set, blocks, app logs,
# headers, and logs fetched from RPC are cached locally. On re-index the
# cached data is read from disk instead of re-downloading.
# Leave empty to disable caching.
# BLOCK_CACHE_DIR=./data/block-cache

# ============================================================
# Optional - Bridge Contract Addresses (defaults are mainnet)
# ============================================================

# Neo X (EVM) contract addresses
# NEOX_TOKEN_BRIDGE=0x1212000000000000000000000000000000000004
# NEOX_MESSAGE_BRIDGE=0x1212000000000000000000000000000000000009

# Neo N3 contract script hashes
# N3_NEOX_BRIDGE=0xbb19cfc864b73159277e1fd39694b3fd5fc613d2
# N3_MESSAGE_BRIDGE=0xde9cc59df7484ae2f2d2c1ce7a66dccbd5c8bd11
